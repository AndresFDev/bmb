<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/xSmall"
    app:cardCornerRadius="@dimen/large">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/xLarge"
            android:layout_height="@dimen/xLarge"
            android:layout_marginEnd="@dimen/xSmall"
            app:cardCornerRadius="@dimen/xLarge">

            <ImageView
                android:id="@+id/ivUserPhoto"
                android:layout_width="@dimen/xLarge"
                android:layout_height="@dimen/xLarge" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerUserImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorPrimary" />

            </com.facebook.shimmer.ShimmerFrameLayout>

        </androidx.cardview.widget.CardView>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/medium"
                android:layout_marginEnd="@dimen/medium"
                app:strokeWidth="@dimen/none">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvChatName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/product_sans_bold"
                    android:paddingHorizontal="@dimen/xSmall"
                    android:textSize="@dimen/textMedium" />

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/colorPrimary" />

                </com.facebook.shimmer.ShimmerFrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvLastMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/xSmall"
                android:layout_marginTop="@dimen/xSmall"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp"
                app:fontFamily="@font/product_sans_regular" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>